{
  "$id": "https://raw.githubusercontent.com/genlayerlabs/genvm-manager/refs/heads/main/docs/schemas/genvm-chainforks.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GenVM chainforks schedule",
  "description": "Forks and when each network activates them. Rules the schema cannot express, such as every network scheduling every fork and requirements activating first, are checked by the manager",
  "type": "object",
  "required": ["forks", "networks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "forks": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          { "$ref": "#/definitions/fork-name" },
          { "not": { "enum": ["always", "never"] } }
        ]
      },
      "additionalProperties": { "$ref": "#/definitions/fork" }
    },
    "networks": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/definitions/network" }
    }
  },
  "definitions": {
    "fork-name": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+(/[a-z0-9._-]+)*$"
    },
    "fork": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "array",
          "items": { "$ref": "#/definitions/fork-name" }
        },
        "description": { "type": ["string", "null"] }
      }
    },
    "activation": {
      "description": "`always`, `never`, or the RFC 3339 timestamp from which the fork is active",
      "anyOf": [
        { "enum": ["always", "never"] },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        }
      ]
    },
    "network": {
      "type": "object",
      "required": ["forks"],
      "additionalProperties": false,
      "properties": {
        "forks": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/activation" }
        }
      }
    }
  }
}
