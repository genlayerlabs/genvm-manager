#!/bin/sh
# Thin wrapper: forwards to `genvm-modules manager` located next to this script.
set -eu

self="$0"
# Resolve symlinks so the wrapper works when linked into PATH.
while [ -L "$self" ]; do
	link="$(readlink "$self")"
	case "$link" in
		/*) self="$link" ;;
		*) self="$(dirname "$self")/$link" ;;
	esac
done

dir="$(cd "$(dirname "$self")" && pwd)"

exec "$dir/genvm-modules" manager "$@"
