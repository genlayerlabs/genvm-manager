{
  "$schema": "vscode://schemas/settings/workspace",
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/executors/v0.3.x/runners/genlayer-py-std/src/",
    "${workspaceFolder}/executors/v0.3.x/runners/genlayer-py-std/src-emb/",
    "${workspaceFolder}/executors/v0.3.x/runners/py-libs/pure-py",
